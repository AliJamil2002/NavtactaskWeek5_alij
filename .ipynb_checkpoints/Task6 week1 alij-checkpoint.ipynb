   ],
   "source": [
    "import cmath\n",
    "\n",
    "num = 1 + 2j\n",
    "mum_sqt = cmath.sqrt(num)\n",
    "\n",
    "print(\"The square root of {0} is {1:0.3f}+{2:0.3f}j\"\n",
    "      .format(num, mum_sqt.real, mum_sqt.imag))"
   ]
